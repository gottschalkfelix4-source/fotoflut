# ---- Basis ----
# FF_BASE_URL: öffentliche URL inkl. Scheme, hinter dem Reverse-Proxy (steuert alle generierten Links)
FF_BASE_URL=http://localhost:8080
# FF_DOMAIN: nur für den mitgelieferten Caddy (docker compose --profile proxy)
FF_DOMAIN=fotos.example.de

# ---- Datenbank / Cache ----
POSTGRES_PASSWORD=change-me

# ---- ML ----
# GPU = Intel Arc via /dev/dri (OpenVINO), alternativ CPU
FF_ML_DEVICE=GPU
# GID der render-Gruppe auf dem Host (find -G render), falls Container sie braucht
FF_RENDER_GID=100

# ---- Datenpfade (Bind-Mounts; auf Unraid z. B. /mnt/user/Fotoflut/...) ----
FF_LIBRARY_DIR=./data/library
FF_DERIV_DIR=./data/derivatives
FF_UPLOAD_DIR=./data/upload
FF_MODEL_CACHE=./data/model-cache

# ---- WebDAV (Platzhalter-Credentials, später pro User aus der Admin-UI) ----
FF_WEBDAV_USER=fotoflut
FF_WEBDAV_PASS=change-me-too
